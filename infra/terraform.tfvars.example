# Copy to terraform.tfvars and fill in your own values. Never commit that file.
project_id           = "your-gcp-project"
github_repository    = "YOUR-OWNER/clef-cloudrun"
github_repository_id = "123456789"
github_owner_id      = "12345678"
invoker_members      = ["user:you@example.com"]

# Confirm RTX PRO 6000 availability and quota for this region before deploying.
region       = "us-central1"
service_name = "clef"
